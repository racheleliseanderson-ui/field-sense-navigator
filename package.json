{
  "name": "field-sense-navigator",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/apply-plan-carefully-overlay.mjs && node scripts/assert-catalog.mjs && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "resolve:stations": "node scripts/resolve-stations.mjs",
    "resolve:names": "node scripts/name-search-unmatched.mjs",
    "resolve:locations": "node scripts/resolve-locations.mjs",
    "bind:weather": "node scripts/bind-weather.mjs",
    "ingest:live": "node scripts/ingest-live.mjs",
    "ingest:critical": "node scripts/ingest-live.mjs --mode=critical --skip-slow --merge",
    "test": "node --test 'scripts/**/*.test.mjs'",
    "scan:closures": "node scripts/scan-closures.mjs",
    "assert:catalog": "node scripts/assert-catalog.mjs",
    "prebuild": "node scripts/apply-plan-carefully-overlay.mjs && node scripts/assert-catalog.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "1.168.23",
    "@tanstack/zod-adapter": "^1.167.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.30.2",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
