# The catalog and its derived files. These are DATA, written by the pipeline
# scripts and by hand-reviewed PRs, and they are the largest files in the
# repository. Reformatting src/data/destinations.json rewrites 2.3 MB in one
# commit, buries the actual record change in a whole-file diff, and makes every
# future catalog PR conflict. `npm run format` must never touch them.
src/data/**
public/live/**
scripts/data/**

# Timestamped pipeline run records. Written by the launchers, never edited.
reports/**

