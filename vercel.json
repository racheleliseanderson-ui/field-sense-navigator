{
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "git": {
    "deploymentEnabled": {
      "live-snapshot": false
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
