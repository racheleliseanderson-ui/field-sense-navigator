# Normalise line endings. The working trees on this machine were CRLF while the
# repository is LF, which made `git status` show every tracked file as modified
# and would have turned any commit into a whole-repo rewrite.
* text=auto eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary
